# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivideo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aivideo
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_MODE=local
STORAGE_PATH=./storage

# AI Providers
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3:latest

TTS_PROVIDER=local
LOCAL_VOICE_ENGINE=f5_tts
F5_TTS_MODEL=F5TTS_v1_Base
F5_TTS_NFE_STEP=32
F5_TTS_SPEED=1
# Long pauses only: keep a short quiet gap so neighboring words stay distinct.
F5_TTS_PAUSE_MIN_SECONDS=0.60
F5_TTS_PAUSE_RETAIN_SECONDS=0.32
F5_TTS_PAUSE_THRESHOLD_DB=-42
# Must match the opening words in the guided presenter recording.
F5_TTS_REFERENCE_TEXT="Hi, thanks for taking a moment to listen. I'm going to talk about a few everyday things in my own words."
IMAGE_PROVIDER=local
VIDEO_PROVIDER=local

# Auth & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
MAX_UPLOAD_SIZE_MB=500
BACKEND_PORT=8000
FRONTEND_PORT=3000
